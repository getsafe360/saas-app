# ═══════════════════════════════════════════════════════════════════════════
# GetSafe 360 AI — environment variables
#
# Generated from an actual scan of every process.env reference in app/, lib/,
# config/, scripts/ and middleware.ts. Variables are grouped by subsystem and
# marked:
#
#   [required]  the app will not work without it
#   [optional]  feature degrades gracefully when unset — the degradation is
#               described so you can decide whether to ship without it
#
# Copy to .env.local for development. Every [required] entry must also be set
# in the Vercel project settings before deploying.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Database ────────────────────────────────────────────────────────────────
#
# IMPORTANT: both names are required, set to the same connection string.
#
# The codebase has two Drizzle clients that read different variables:
#   lib/db/drizzle.ts  (node-postgres)  reads POSTGRES_URL
#     → used by /api/scan/*, /api/fix/*, /api/sites/*, /api/team/*
#   lib/db/postgres.ts (postgres-js)    reads DATABASE_URL
#     → used by /api/connect/*, lib/ai/models.ts, the WordPress agent routes
#
# Setting only one of them leaves roughly half the API returning 500s, with
# the misleading message "POSTGRES_URL is not set" or "DATABASE_URL is not
# set" depending on which route you hit first.
#
# drizzle.config.ts reads DATABASE_URL, falling back to POSTGRES_URL.
#
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require        # [required]
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require        # [required] same value as DATABASE_URL


# ─── Clerk Auth ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...                              # [required]
CLERK_SECRET_KEY=sk_live_...                                               # [required]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in                                  # [optional] Clerk defaults apply
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/sign-up                                  # [optional]
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/en/dashboard                          # [optional]
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/en/dashboard                          # [optional]

# Comma-separated Clerk user IDs that bypass rate limits and can reach
# /api/debug/env and /api/jobs/cleanup. Leave empty to disable admin bypass
# entirely — an empty value means nobody is an admin, which is the safe default.
ADMIN_CLERK_USER_IDS=user_abc,user_def                                     # [optional]

# Signing key for the legacy JWT session helper in lib/auth/session.ts.
# Generate with: openssl rand -base64 32
AUTH_SECRET=                                                               # [required]


# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...                                              # [required]
STRIPE_PUBLISHABLE_KEY=pk_live_...                                         # [required]
# From the Stripe dashboard → Developers → Webhooks → your endpoint.
# The webhook must subscribe to at least: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_succeeded.
STRIPE_WEBHOOK_SECRET=whsec_...                                            # [required]


# ─── Resend Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                                                      # [required]

# Resend hosted template IDs (dashboard → Emails → Templates → copy ID).
# When a template ID is missing, lib/email/send.ts falls back to a built-in
# plain HTML version of that email rather than sending nothing — so mail still
# reaches users on day one, it just is not brand-designed yet.
RESEND_TEMPLATE_WELCOME=                                                   # [optional]
RESEND_TEMPLATE_SUBSCRIPTION=                                              # [optional]
RESEND_TEMPLATE_SCAN_COMPLETE=                                             # [optional]
RESEND_TEMPLATE_FIX_COMPLETE=                                              # [optional]
RESEND_TEMPLATE_PAYMENT_RECEIPT=                                           # [optional]

# Printed in the footer of the payment receipt for invoicing compliance.
COMPANY_ADDRESS=Your Company Name, Street, City, Country                   # [optional]


# ─── Vercel Blob ─────────────────────────────────────────────────────────────
# Stores scan reports, fix proposals and fix results.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...                                   # [required]
# Public read base for blobs rendered in the UI. Either form works.
NEXT_PUBLIC_BLOB_BASE_URL=https://<store-id>.public.blob.vercel-storage.com # [optional]
BLOB_PUBLIC_BASE=https://<store-id>.public.blob.vercel-storage.com          # [optional] fallback for the above
NEXT_PUBLIC_BLOB_STORE_ID=<store-id>                                        # [optional] used by lib/stash/retrieveStash.ts


# ─── Upstash Redis ───────────────────────────────────────────────────────────
# Backs rate limiting, the WordPress pairing-code store and the email dedup
# keys. Without it, rate limits fall back to per-instance in-memory counters
# (not a real distributed limit) and WordPress pairing returns 503.
#
# lib/api/redis.ts accepts either naming pair; prefer KV_REST_API_* since that
# is what the Vercel Upstash integration injects.
KV_REST_API_URL=https://...upstash.io                                      # [required in production]
KV_REST_API_TOKEN=                                                         # [required in production]
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as aliases.


# ─── AI providers ────────────────────────────────────────────────────────────
# Scan prose, meta-description generation and the SEO analysis stream.
# Without it the scan still runs and still produces findings — it falls back
# to a factual, non-LLM summary.
OPENAI_API_KEY=sk-...                                                      # [optional but recommended]
MODEL=gpt-4o-mini                                                          # [optional] default model for OpenAI calls

# Claude is used for agent/agency/business tier SEO analysis.
ANTHROPIC_API_KEY=sk-ant-...                                               # [optional]

# Powers the homepage "Sparky" quick snapshot (/api/agent/stream).
GEMINI_API_KEY=                                                            # [optional] snapshot degrades without it
GEMINI_SNAPSHOT_MODEL=gemini-3-flash-preview                               # [optional]

# Google PageSpeed Insights. Without it the scan still scores every category
# from its own rules; with it, performance/accessibility/SEO scores are
# blended with real Lighthouse measurements.
PAGESPEED_API_KEY=                                                         # [optional but recommended]


# ─── CrewAI / agent backends ─────────────────────────────────────────────────
# Flask service behind /api/agent/* and /api/test/*. NOTE: the code reads
# CREW_SERVICE_BASE_URL — an earlier .env.example documented CREW_AI_BASE_URL,
# which nothing reads.
CREW_SERVICE_BASE_URL=http://localhost:5000                                # [optional] /api/agent/start returns 500 without it
CREW_SERVICE_API_KEY=                                                      # [optional] sent as a Bearer token when set
# Alternative base URLs checked by lib/homepage/test-service-config.ts:
# HOMEPAGE_TEST_SERVICE_BASE_URL, TEST_SERVICE_BASE_URL

# Separate agents service used by lib/services/agents.ts.
AGENTS_BASE_URL=                                                           # [optional]
AGENTS_API_KEY=                                                            # [optional]

# WordPress fact analyzer used by /api/analyze-facts.
WP_ANALYZER_ENDPOINT=http://localhost:5555/analyze                         # [optional] defaults to this value


# ─── Token economy & pricing ─────────────────────────────────────────────────
# Defaults live in config/billing/. Override only to change launch pricing.
TOKENS_PER_FIX_UNIT=2000                                                   # [optional] default 2000
FIX_UNITS_MINOR=1                                                          # [optional] default 1
FIX_UNITS_MEDIUM=3                                                         # [optional] default 3
FIX_UNITS_MAJOR=8                                                          # [optional] default 8
PRO_PLAN_PRICE_EUR=19                                                      # [optional] default 19


# ─── App URLs ────────────────────────────────────────────────────────────────
# BASE_URL is used for Stripe success/cancel redirects and for links inside
# emails. Getting this wrong in production sends paying customers to localhost.
BASE_URL=https://www.getsafe360.ai                                         # [required]
NEXT_PUBLIC_BASE_URL=https://www.getsafe360.ai                             # [required]
NEXT_PUBLIC_SITE_URL=https://www.getsafe360.ai                             # [optional] canonical/OG metadata


# ─── WordPress connector ─────────────────────────────────────────────────────
# Public URL of the plugin ZIP. /api/wp-plugin/info returns 503 when unset,
# which deliberately stops WordPress advertising a broken update to every
# connected site.
WP_PLUGIN_DOWNLOAD_URL=https://www.getsafe360.ai/wp-plugin/getsafe360-connector.zip  # [required]

# Shared secret required by /api/connect/provision.
PROVISION_SECRET=                                                          # [required]

# Optional allowlist regex restricting which hostnames may be paired.
# Useful during a closed beta: e.g. ^(staging\.)?example\.(com|de)$
ALLOWED_SITE_HOST_REGEX=                                                   # [optional] all public hosts allowed when unset


# ─── Operations ──────────────────────────────────────────────────────────────
# Vercel Cron sends this as "Authorization: Bearer <value>" to
# /api/jobs/cleanup, which sweeps timed-out scan and fix jobs and releases
# held tokens. Without it the endpoint is admin-session only and the cron
# silently 404s.
CRON_SECRET=                                                               # [required in production]

# debug | info | warn | error. Defaults to info in production, debug otherwise.
LOG_LEVEL=info                                                             # [optional]
