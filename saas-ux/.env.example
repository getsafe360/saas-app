# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/en/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/en/dashboard

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend Email ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# Resend template IDs — find in Resend dashboard → Emails → Templates
RESEND_TEMPLATE_WELCOME=...
RESEND_TEMPLATE_SUBSCRIPTION=...
RESEND_TEMPLATE_SCAN_COMPLETE=...
RESEND_TEMPLATE_FIX_COMPLETE=...
RESEND_TEMPLATE_PAYMENT_RECEIPT=...

# ─── Vercel Blob ──────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Upstash Redis (optional — falls back to in-memory) ──────────────────────
KV_REST_API_URL=https://...upstash.io
KV_REST_API_TOKEN=...

# ─── CrewAI Backend ───────────────────────────────────────────────────────────
CREW_AI_BASE_URL=http://localhost:5000
CREW_MODEL=anthropic/claude-opus-4-6

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://www.getsafe360.ai
BASE_URL=https://www.getsafe360.ai
COMPANY_ADDRESS=Your Company Name, Street, City, Country

# ─── WordPress Plugin ─────────────────────────────────────────────────────────
